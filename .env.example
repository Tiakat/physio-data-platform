# Copy to .env and edit. .env is never committed.

# PostgreSQL
PG_USER=lab
PG_PASSWORD=change_me_now
PG_DATABASE=labdata
PG_HOST=db
PG_PORT=5432

# Local object storage for development
STORAGE_KEY=labminio
STORAGE_SECRET=change_me_now
STORAGE_ENDPOINT=storage:9000

# Local data directory
DATA_ROOT=./data

# Azure Blob Storage for production
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_RAW=rawdata

# Application
PROFILE_DIR=./profiles
PIPELINE_VERSION=0.1.0