# Copy to .env and edit. .env is never committed.

# PostgreSQL
POSTGRES_USER=lab
POSTGRES_PASSWORD=change_me_now
POSTGRES_DB=labdata
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local object storage for development
MINIO_ROOT_USER=labminio
MINIO_ROOT_PASSWORD=change_me_now
MINIO_ENDPOINT=minio:9000

# Azure Blob Storage for production
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_RAW=rawdata

# Application
PROFILE_DIR=./profiles
PIPELINE_VERSION=0.1.0